<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.EditTagRuleDialogView"
             x:DataType="dialogs:EditTagRuleDialogViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="dialogTitle" Text="{Binding TitleText}" />
        <StackPanel Grid.Row="1">
            <TextBox Text="{Binding TagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Name" Loaded="DialogTextBox_Loaded" />

            <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"
                      PlaceholderText="Select an operator" />

            <TextBox Text="{Binding TagValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Value"
                     IsVisible="{Binding SelectedOperator, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='ANY'}"
                     Loaded="DialogTextBox_Loaded" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Grid > StackPanel">
            <Setter Property="Spacing" Value="4" />

            <Style Selector="^ > ComboBox">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Style>
    </UserControl.Styles>
</UserControl>