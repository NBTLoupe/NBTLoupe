<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.UnsavedChangesDialogView"
             x:DataType="dialogs:UnsavedChangesDialogViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Text="Unsaved changes!"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
            <TextBlock
                Text="Are you sure you want to continue? Unsaved changes will be lost!"
                TextWrapping="Wrap" FontSize="14"
                HorizontalAlignment="Left" VerticalAlignment="Top" />
        </StackPanel>
    </Grid>
</UserControl>