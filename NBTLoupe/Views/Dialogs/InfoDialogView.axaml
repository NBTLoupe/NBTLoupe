<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.InfoDialogView"
             x:DataType="dialogs:InfoDialogViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="dialogTitle" Text="Info" />
        <TextBlock Grid.Row="1" Classes="dialogSubtitle" Text="{Binding MessageText}" />
    </Grid>
</UserControl>