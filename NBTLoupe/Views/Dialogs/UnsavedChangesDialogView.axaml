<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.UnsavedChangesDialogView"
             x:DataType="dialogs:UnsavedChangesDialogViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Classes="dialogTitle" Text="Unsaved changes!" />
        <TextBlock Grid.Row="1" Classes="dialogSubtitle"
                   Text="Are you sure you want to continue? Unsaved changes will be lost!" />
    </Grid>
</UserControl>