<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.ChunkFinderDialogView"
             x:DataType="dialogs:ChunkFinderDialogViewModel">
    <Grid RowDefinitions="Auto,*" IsEnabled="{Binding !InProgress}">
        <TextBlock Classes="dialogTitle" Text="Chunk Finder" />
        <UniformGrid Grid.Row="1" Columns="3" Classes="groupBoxer">
            <!-- Region Column -->
            <StackPanel>
                <!-- Region Group -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="Region" />
                        <NumericUpDown PlaceholderText="{Binding RegionXPlaceholder}"
                                       Value="{Binding RegionX, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="X:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>

                        <NumericUpDown PlaceholderText="{Binding RegionZPlaceholder}"
                                       Value="{Binding RegionZ, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="Z:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Chunk Column -->
            <StackPanel>
                <!-- Chunk Group -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="Chunk" />
                        <NumericUpDown PlaceholderText="{Binding ChunkXPlaceholder}"
                                       Value="{Binding ChunkX, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="X:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>

                        <NumericUpDown PlaceholderText="{Binding ChunkZPlaceholder}"
                                       Value="{Binding ChunkZ, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="Z:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>
                    </StackPanel>
                </Border>

                <!-- Local Chunk Group -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="Local Chunk" />
                        <NumericUpDown PlaceholderText="{Binding LocalChunkXPlaceholder}"
                                       Value="{Binding LocalChunkX, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="X:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>

                        <NumericUpDown PlaceholderText="{Binding LocalChunkZPlaceholder}"
                                       Value="{Binding LocalChunkZ, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="Z:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Block Column -->
            <StackPanel>
                <!-- Block Group -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="Block" />
                        <NumericUpDown PlaceholderText="{Binding BlockXPlaceholder}"
                                       Value="{Binding BlockX, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="X:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>

                        <NumericUpDown PlaceholderText="{Binding BlockZPlaceholder}"
                                       Value="{Binding BlockZ, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="Z:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>
                    </StackPanel>
                </Border>

                <!-- Local Block Group -->
                <Border>
                    <StackPanel>
                        <TextBlock Text="Local Block" />
                        <NumericUpDown PlaceholderText="{Binding LocalBlockXPlaceholder}"
                                       Value="{Binding LocalBlockX, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="X:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>

                        <NumericUpDown PlaceholderText="{Binding LocalBlockZPlaceholder}"
                                       Value="{Binding LocalBlockZ, Mode=TwoWay}">
                            <NumericUpDown.InnerLeftContent>
                                <TextBlock Classes="innerLeftLabel" Text="Z:" />
                            </NumericUpDown.InnerLeftContent>
                        </NumericUpDown>
                    </StackPanel>
                </Border>
            </StackPanel>
        </UniformGrid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="UniformGrid.groupBoxer > StackPanel">
            <Setter Property="Spacing" Value="8" />
            <Style Selector="^ > Border">
                <Style Selector="^ > StackPanel">
                    <Setter Property="Spacing" Value="4" />
                    <Style Selector="^ NumericUpDown">
                        <Setter Property="MinWidth" Value="140" />
                        <Setter Property="ShowButtonSpinner" Value="False" />
                        <Setter Property="AllowSpin" Value="False" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </UserControl.Styles>
</UserControl>