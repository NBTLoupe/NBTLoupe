<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NBTLoupe.ViewModels.Dialogs"
             x:Class="NBTLoupe.Views.Dialogs.EditTagDialogView"
             x:DataType="dialogs:EditTagDialogViewModel">
    <!-- Edit Tag Value -->
    <Grid RowDefinitions="Auto,*">
        <TextBlock TextWrapping="Wrap"
                   Text="{Binding TitleText}"
                   FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBox Loaded="DialogTextBox_Loaded"
                     Text="{Binding TagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     PlaceholderText="Name"
                     IsVisible="{Binding NameVisible}" />

            <TextBox x:Name="EditValueTextBox"
                     Loaded="DialogTextBox_Loaded"
                     Text="{Binding TagValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     MinLines="5" MaxLines="10"
                     IsVisible="{Binding ValueVisible}">
                <TextBox.InnerLeftContent>
                    <TextBlock Text="Value:" VerticalAlignment="Top"
                               Margin="10 6 0 0" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>
    </Grid>
</UserControl>